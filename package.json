{
  "name": "@mirzasaikatahmmed/token-monitor",
  "version": "1.0.0",
  "description": "Token Monitor agent CLI — collect Claude / Puku / Cursor usage and ship it to your dashboard",
  "keywords": [
    "token-monitor",
    "claude",
    "cursor",
    "puku",
    "ai",
    "usage",
    "cli"
  ],
  "license": "MIT",
  "author": "Token Monitor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirzasaikatahmed/Token-Monitor.git",
    "directory": "token-monitor-package"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "token-monitor": "dist/cli.js"
  },
  "files": [
    "dist",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "sync-vendor": "bash scripts/sync-vendor.sh",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ora": "^8.2.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
